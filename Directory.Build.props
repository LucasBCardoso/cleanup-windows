<Project>
  <!-- Shared by every project. Platform code targets Windows 10 22H2+ (design §11.3). -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WindowsTarget>net10.0-windows10.0.19041.0</WindowsTarget>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</SupportedOSPlatformVersion>
    <!-- major.minor from VERSION; publish.ps1 and the release pass the full -p:Version (scripts/version.ps1). -->
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim()).0</Version>
    <!-- File details of every binary. SignPath signs a file only when its product name and version match the release
         (.signpath/), so the product version stays the plain X.Y.N, without the commit hash the SDK appends. -->
    <Product>Cleanup</Product>
    <Company>Lucas Cardoso</Company>
    <Copyright>Copyright (c) 2026 Lucas Cardoso</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
