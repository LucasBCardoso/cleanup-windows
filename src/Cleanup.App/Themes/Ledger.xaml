<!-- Ledger (dark). Every color is shared/design-tokens.json themes.ledger; DesignTokensTests keeps them in step.
     Key = token name in PascalCase + "Color". Opacity is the alpha byte (#AARRGGBB): 0.14 → 0x24. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#FF0C0E11</Color>
    <Color x:Key="SurfaceColor">#FF12151A</Color>
    <Color x:Key="SurfaceSoftColor">#FF1E232A</Color>
    <Color x:Key="HairlineColor">#FF232830</Color>
    <Color x:Key="InkColor">#FFEDEFF2</Color>
    <Color x:Key="BodyColor">#FFC3C8D0</Color>
    <Color x:Key="MuteColor">#FF858C97</Color>
    <Color x:Key="AccentColor">#FFFF6A2B</Color>
    <Color x:Key="AccentSoftColor">#24FF6A2B</Color>
    <Color x:Key="AccentInkColor">#FFFF8A55</Color>
    <Color x:Key="OnAccentColor">#FF160803</Color>
    <Color x:Key="AccentStartColor">#FFEA3F2C</Color>
    <Color x:Key="AccentEndColor">#FFFF8A1F</Color>
    <Color x:Key="HeroBackgroundColor">#FF171B21</Color>
    <Color x:Key="HeroForegroundColor">#FFEDEFF2</Color>
    <Color x:Key="HeroAmountColor">#FFFF7A3D</Color>
    <Color x:Key="HeroButtonColor">#FFFF6A2B</Color>
    <Color x:Key="HeroButtonTextColor">#FF160803</Color>
    <Color x:Key="OkColor">#FF6BD49A</Color>
    <Color x:Key="WarnColor">#FFF2C14E</Color>
    <Color x:Key="WarnSoftColor">#24F2C14E</Color>
    <Color x:Key="DangerColor">#FFFF6B6B</Color>
</ResourceDictionary>
