<!-- Theme-independent tokens from shared/design-tokens.json: fonts, radii (Radius*), type sizes (FontSize*), brand.
     Sizes are effective pixels. DesignTokensTests keeps them in step. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/BricolageGrotesque.ttf#Bricolage Grotesque</FontFamily>
    <FontFamily x:Key="TextFontFamily">ms-appx:///Assets/Fonts/Onest.ttf#Onest</FontFamily>

    <x:Double x:Key="RadiusRow">12</x:Double>
    <x:Double x:Key="RadiusPanel">20</x:Double>
    <x:Double x:Key="RadiusHero">28</x:Double>
    <x:Double x:Key="RadiusIcon">10</x:Double>
    <x:Double x:Key="RadiusCheckbox">6</x:Double>

    <x:Double x:Key="FontSizeModuleTitle">28</x:Double>
    <x:Double x:Key="FontSizeRowTitle">13.5</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeSectionLabel">11</x:Double>
    <x:Double x:Key="FontSizeButton">13.5</x:Double>
    <x:Double x:Key="FontSizeNumber">13</x:Double>

    <Color x:Key="IconStartColor">#FF5A80FF</Color>
    <Color x:Key="IconMidColor">#FF2D5BFF</Color>
    <Color x:Key="IconEndColor">#FF1E42D6</Color>
    <Color x:Key="IconSparkColor">#FFD4FF3A</Color>
</ResourceDictionary>
