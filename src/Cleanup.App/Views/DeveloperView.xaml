<UserControl
    x:Class="Cleanup.App.Views.DeveloperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:views="using:Cleanup.App.Views"
    xmlns:controls="using:Cleanup.App.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Name="ProjectGroups" Source="{x:Bind Model.Projects.Groups, Mode=OneWay}" IsSourceGrouped="True" />
        <CollectionViewSource x:Name="CacheGroups" Source="{x:Bind Model.Caches.Groups, Mode=OneWay}" IsSourceGrouped="True" />

        <Style x:Key="GroupHeaderContainer" TargetType="ListViewHeaderItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="RowContainer" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <DataTemplate x:Key="GroupHeader" x:DataType="vm:ItemGroup">
            <Grid Padding="4,10,8,4">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,18,24,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Desenvolvedor" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="ProjectsTabButton" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind Model.ShowProjects, Mode=OneWay}" Click="OnProjectsTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        <TextBlock Text="Projetos" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="CachesTabButton" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind Model.ShowCaches, Mode=OneWay}" Click="OnCachesTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B8;" FontSize="12" />
                        <TextBlock Text="Caches" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ToolsTabButton" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind Model.ShowTools, Mode=OneWay}" Click="OnToolsTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE90F;" FontSize="12" />
                        <TextBlock Text="Ferramentas" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind Model.AgeLabels}" SelectedIndex="{x:Bind Model.AgeIndex, Mode=TwoWay}" MinWidth="170"
                      VerticalAlignment="Center" Visibility="{x:Bind Show(Model.ShowProjects), Mode=OneWay}"
                      ToolTipService.ToolTip="Pela última alteração no projeto (arquivos e commits)" />
            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Model.ScanCommand}" VerticalAlignment="Center"
                    Visibility="{x:Bind Hide(Model.ShowTools), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind Model.IsScanning, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                  Visibility="{x:Bind Show(Model.IsScanning), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE721;" FontSize="13" Visibility="{x:Bind Hide(Model.IsScanning), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Model.ScanTitle, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Project folders: the usual ones that exist, plus the user's own (removable). -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled" Padding="24,0,24,10" Visibility="{x:Bind Show(Model.ShowProjects), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Pastas:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Model.FoldersSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource BodyBrush}" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{x:Bind Model.Folders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderChip">
                            <Border Background="{ThemeResource SurfaceSoftBrush}" CornerRadius="12" Padding="10,4" ToolTipService.ToolTip="{x:Bind Path}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BodyBrush}" VerticalAlignment="Center" />
                                    <Button Background="Transparent" BorderThickness="0" Padding="2" MinWidth="0" MinHeight="0" Click="OnRemoveFolder" Tag="{x:Bind}"
                                            Visibility="{x:Bind IsCustom}" ToolTipService.ToolTip="Remover pasta">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Background="Transparent" BorderThickness="0" Padding="8,4" Click="OnAddFolder">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AccentInkBrush}" />
                        <TextBlock Text="Adicionar pasta" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <controls:SelectionBar Grid.Row="2" List="{x:Bind Model.Projects}" Visibility="{x:Bind Show(Model.ShowProjectsList), Mode=OneWay}" />
        <controls:SelectionBar Grid.Row="2" List="{x:Bind Model.Caches}" Visibility="{x:Bind Show(Model.ShowCachesList), Mode=OneWay}" />

        <!-- Projects: idle, scanning, empty, list -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowProjectsIdle), Mode=OneWay}">
            <FontIcon Glyph="&#xE943;" FontSize="40" Foreground="{ThemeResource MuteBrush}" />
            <TextBlock Text="Projetos parados" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Encontre dependências e saídas de build que podem ser recriadas. Nada é selecionado automaticamente."
                       Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind Show(Model.ShowProjectsProgress), Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Model.ShowProjectsProgress, Mode=OneWay}" Width="56" Height="56" />
            <TextBlock Text="Procurando projetos…" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="node_modules, venv, target, build, bin/obj e outros." Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460" Visibility="{x:Bind Show(Model.ShowProjectsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource OkBrush}" />
            <TextBlock Text="Nada encontrado" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Nenhum projeto parado com saídas de build nessas pastas." Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ProjectGroups.View, Mode=OneWay}" SelectionMode="None" Padding="10,0,10,8"
                  ItemContainerStyle="{StaticResource RowContainer}" Visibility="{x:Bind Show(Model.ShowProjectsList), Mode=OneWay}">
            <ListView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource GroupHeaderContainer}" HeaderTemplate="{StaticResource GroupHeader}" />
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRow">
                    <Border Style="{StaticResource RowCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" ToolTipService.ToolTip="{x:Bind Item.Path}" />
                                <TextBlock Text="{x:Bind views:DeveloperView.Detail(Id)}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE712;" FontSize="13" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Mostrar no Explorador" Click="OnReveal" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Nunca sugerir esta pasta" Click="OnIgnore" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Caches: idle, scanning, empty, list -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowCachesIdle), Mode=OneWay}">
            <FontIcon Glyph="&#xE7B8;" FontSize="40" Foreground="{ThemeResource MuteBrush}" />
            <TextBlock Text="Caches de desenvolvimento" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="npm, pnpm, Yarn, pip, NuGet, Gradle, Maven, Visual Studio, VS Code, JetBrains e imagens do emulador Android. Tudo é baixado ou recriado quando preciso."
                       Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind Show(Model.ShowCachesProgress), Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Model.ShowCachesProgress, Mode=OneWay}" Width="56" Height="56" />
            <TextBlock Text="Medindo caches…" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460" Visibility="{x:Bind Show(Model.ShowCachesEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource OkBrush}" />
            <TextBlock Text="Nenhum cache encontrado" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind CacheGroups.View, Mode=OneWay}" SelectionMode="None" Padding="10,0,10,8"
                  ItemContainerStyle="{StaticResource RowContainer}" Visibility="{x:Bind Show(Model.ShowCachesList), Mode=OneWay}">
            <ListView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource GroupHeaderContainer}" HeaderTemplate="{StaticResource GroupHeader}" />
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRow">
                    <Border Style="{StaticResource RowCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource TagStyle}" Visibility="{x:Bind IsReview}">
                                <TextBlock Text="Revisar" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE712;" FontSize="13" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Mostrar no Explorador" Click="OnReveal" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Nunca sugerir este item" Click="OnIgnore" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Tools: Docker and WSL disks -->
        <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Padding="24,0,24,12" Visibility="{x:Bind Show(Model.ShowTools), Mode=OneWay}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Show(Model.IsLoadingTools), Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind Model.IsLoadingTools, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock Text="Verificando ferramentas…" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <TextBlock Text="Nenhuma ferramenta encontrada: o Docker e o WSL não estão instalados." Style="{StaticResource BodyTextStyle}"
                           Foreground="{ThemeResource MuteBrush}" Visibility="{x:Bind Show(Model.ShowNoTools), Mode=OneWay}" />

                <StackPanel Spacing="6" Visibility="{x:Bind Show(Model.HasDocker)}">
                    <TextBlock Text="DOCKER" Style="{StaticResource SectionLabelStyle}" Margin="4,8,0,2" />
                    <Border Style="{StaticResource RowCardStyle}" Visibility="{x:Bind Show(Model.ShowDockerError), Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="Docker indisponível" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind Model.DockerError, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind Model.Docker}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolRow">
                                <Border Style="{StaticResource RowCardStyle}" Margin="0,0,0,6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource AccentInkBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Value}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="{x:Bind Show(Model.ShowDockerActions), Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind Hide2(Model.ToolsIdle), Mode=OneWay}" Width="16" Height="16" />
                        <Button Style="{StaticResource SubtleButtonStyle}" Content="Limpar cache de build" Click="OnPruneBuildCache" IsEnabled="{x:Bind Model.ToolsIdle, Mode=OneWay}" />
                        <Button Style="{StaticResource SubtleButtonStyle}" Content="Remover imagens sem uso" Click="OnPruneImages" IsEnabled="{x:Bind Model.ToolsIdle, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="Volumes nunca são removidos: eles guardam dados. O Docker apaga direto, sem passar pela Lixeira."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Right" />
                </StackPanel>

                <TextBlock Text="DISCOS DO WSL" Style="{StaticResource SectionLabelStyle}" Margin="4,14,0,2" />
                <TextBlock Text="Nenhum disco do WSL encontrado." Style="{StaticResource CaptionTextStyle}" Margin="4,0,0,4"
                           Visibility="{x:Bind Show(Model.ShowNoWslDisks), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind Model.WslDisks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolRow">
                            <Border Style="{StaticResource RowCardStyle}" Margin="0,0,0,6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentInkBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Value}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center" Click="OnRevealTool"
                                            Tag="{x:Bind}" ToolTipService.ToolTip="Mostrar no Explorador">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                           Text="Só para consulta: o Cleanup nunca mexe nesses discos. Para recuperar espaço, apague arquivos dentro da distribuição e ative o disco esparso (wsl --manage &lt;nome&gt; --set-sparse true)." />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="4" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12">
            <Grid ColumnSpacing="16" MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Visibility="{x:Bind Show(Model.ShowFooter), Mode=OneWay}">
                    <TextBlock Text="SELECIONADO" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{x:Bind Model.SelectedSizeText, Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="22" />
                </StackPanel>
                <controls:BannerView Grid.Column="1" VerticalAlignment="Center" Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Model.CleanCommand}" VerticalAlignment="Center"
                        Visibility="{x:Bind Show(Model.ShowFooter), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsCleaning, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Show(Model.IsCleaning), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Visibility="{x:Bind Hide(Model.IsCleaning), Mode=OneWay}" />
                        <TextBlock Text="Mover para a Lixeira" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
