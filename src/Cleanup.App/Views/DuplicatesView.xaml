<UserControl
    x:Class="Cleanup.App.Views.DuplicatesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:views="using:Cleanup.App.Views"
    xmlns:controls="using:Cleanup.App.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Name="IdenticalGroups" Source="{x:Bind Model.Identical.Groups, Mode=OneWay}" IsSourceGrouped="True" />
        <CollectionViewSource x:Name="SimilarGroups" Source="{x:Bind Model.Similar.Groups, Mode=OneWay}" IsSourceGrouped="True" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, tabs, size, similarity level, search / cancel. -->
        <Grid Padding="24,18,24,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Duplicados" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="IdenticalTabButton" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind Model.IsIdenticalTab, Mode=OneWay}" Click="OnIdenticalTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        <TextBlock Text="Idênticos" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SimilarTabButton" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind Model.IsSimilarTab, Mode=OneWay}" Click="OnSimilarTab">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                        <TextBlock Text="Fotos parecidas" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind Model.SizeLabels}" SelectedIndex="{x:Bind Model.SizeIndex, Mode=TwoWay}"
                      MinWidth="150" VerticalAlignment="Center" IsEnabled="{x:Bind Model.CanEditFolders, Mode=OneWay}"
                      ToolTipService.ToolTip="Tamanho mínimo dos arquivos idênticos" />
            <ComboBox Grid.Column="3" ItemsSource="{x:Bind Model.SimilarityLabels}" SelectedIndex="{x:Bind Model.SimilarityIndex, Mode=TwoWay}"
                      MinWidth="170" VerticalAlignment="Center" Visibility="{x:Bind Show(Model.ShowSimilarity), Mode=OneWay}"
                      IsEnabled="{x:Bind Model.CanEditFolders, Mode=OneWay}"
                      ToolTipService.ToolTip="Quanto as fotos precisam se parecer. Vale para a próxima busca." />
            <Grid Grid.Column="4" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Model.ScanCommand}" Visibility="{x:Bind Hide(Model.IsScanning), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind Model.ScanGlyph, Mode=OneWay}" FontSize="13" />
                        <TextBlock Text="{x:Bind Model.ScanTitle, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.CancelCommand}" Visibility="{x:Bind Show(Model.IsScanning), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsScanning, Mode=OneWay}" Width="14" Height="14" />
                        <TextBlock Text="Cancelar" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Folders: quick picks and the user's own; one tap turns a folder on or off. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled" Padding="24,0,24,10">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Pastas:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{x:Bind Model.Folders}" IsEnabled="{x:Bind Model.CanEditFolders, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderChip">
                            <ToggleButton Style="{StaticResource SubTabButtonStyle}" Background="{ThemeResource SurfaceSoftBrush}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Click="OnFolderToggled"
                                          Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind Path}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Visibility="{x:Bind IsOn, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Title}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Background="Transparent" BorderThickness="0" Padding="8,4" Click="OnAddFolder" IsEnabled="{x:Bind Model.CanEditFolders, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AccentInkBrush}" />
                        <TextBlock Text="Adicionar pasta" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <controls:SelectionBar Grid.Row="2" List="{x:Bind Model.Identical}" Visibility="{x:Bind Show(Model.ShowIdenticalBar), Mode=OneWay}" />
        <controls:SelectionBar Grid.Row="2" List="{x:Bind Model.Similar}" Visibility="{x:Bind Show(Model.ShowSimilarBar), Mode=OneWay}" />

        <!-- Idle -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowIdle), Mode=OneWay}">
            <FontIcon Glyph="&#xE8C8;" FontSize="40" Foreground="{ThemeResource MuteBrush}" />
            <TextBlock Text="Duplicados" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Model.IdleMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextAlignment="Center"
                       Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>

        <!-- Working -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowProgress), Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Model.ShowProgress, Mode=OneWay}" Width="56" Height="56" />
            <TextBlock Text="{x:Bind Model.PhaseTitle, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Pode demorar em pastas grandes. Arquivos só na nuvem não são baixados." Style="{StaticResource BodyTextStyle}"
                       TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>

        <!-- Empty results -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowIdenticalEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource OkBrush}" />
            <TextBlock Text="Nenhum arquivo repetido" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Model.IdenticalEmptyMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowSimilarEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource OkBrush}" />
            <TextBlock Text="Nenhuma foto parecida" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Nada parecido entre as imagens dessas pastas." Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                    Visibility="{x:Bind Show(Model.ShowPhotosCancelled), Mode=OneWay}">
            <FontIcon Glyph="&#xE711;" FontSize="36" Foreground="{ThemeResource MuteBrush}" />
            <TextBlock Text="Análise de fotos cancelada" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Os arquivos idênticos continuam na outra aba. Procure de novo para comparar as fotos." Style="{StaticResource BodyTextStyle}"
                       TextAlignment="Center" Foreground="{ThemeResource MuteBrush}" />
        </StackPanel>

        <!-- Identical files -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind IdenticalGroups.View, Mode=OneWay}" SelectionMode="None" Padding="10,0,10,8"
                  Visibility="{x:Bind Show(Model.ShowIdenticalList), Mode=OneWay}">
            <ListView.Header>
                <TextBlock Margin="8,0,8,4" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                           Text="Uma cópia de cada grupo sempre fica (marcada &quot;Fica&quot;). Tudo vai para a Lixeira e pode ser desfeito no Histórico." />
            </ListView.Header>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ItemGroup">
                            <TextBlock Margin="4,12,8,4" Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRow">
                    <Border Style="{StaticResource RowCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource TagStyle}" Background="{ThemeResource AccentSoftBrush}"
                                    Visibility="{x:Bind views:DuplicatesView.KeeperVisibility(Id)}">
                                <TextBlock Text="Fica" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{x:Bind views:DuplicatesView.DateText(Item.LastWriteUtc)}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center"
                                    Click="OnReveal" Tag="{x:Bind}" ToolTipService.ToolTip="Mostrar no Explorador">
                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Similar photos: tiles per group -->
        <GridView Grid.Row="3" ItemsSource="{x:Bind SimilarGroups.View, Mode=OneWay}" SelectionMode="None" Padding="18,0,18,8"
                  ContainerContentChanging="OnPhotoContainerChanging"
                  Visibility="{x:Bind Show(Model.ShowSimilarList), Mode=OneWay}">
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="GridViewHeaderItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ItemGroup">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,12,8,6">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,4" Click="OnKeepBest" Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE734;" FontSize="11" />
                                        <TextBlock Text="Manter a melhor" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRow">
                    <Border Width="166" Style="{StaticResource RowCardStyle}" Padding="8" ToolTipService.ToolTip="{x:Bind Item.Path}">
                        <StackPanel Spacing="6">
                            <Grid Width="150" Height="112" CornerRadius="8" Background="{ThemeResource SurfaceSoftBrush}">
                                <FontIcon Glyph="&#xEB9F;" FontSize="22" Foreground="{ThemeResource MuteBrush}" />
                                <Image Stretch="UniformToFill" />
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" Margin="8,6,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Border Style="{StaticResource TagStyle}" Background="{ThemeResource SurfaceBrush}" Margin="0,8,8,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{x:Bind views:DuplicatesView.KeeperVisibility(Id)}">
                                    <TextBlock Text="Melhor" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" FontSize="12" />
                            <Grid>
                                <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextStyle}" />
                                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,0" Click="OnReveal" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Mostrar no Explorador">
                                    <FontIcon Glyph="&#xE838;" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Footer -->
        <Border Grid.Row="4" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Visibility="{x:Bind Show(Model.HasResults), Mode=OneWay}">
                    <TextBlock Text="SELECIONADO" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{x:Bind Model.SelectedSizeText, Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="22" />
                </StackPanel>
                <controls:BannerView Grid.Column="1" VerticalAlignment="Center" Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                <ComboBox Grid.Column="2" ItemsSource="{x:Bind Model.KeepRuleLabels}" SelectedIndex="{x:Bind Model.KeepRuleIndex, Mode=TwoWay}"
                          MinWidth="200" VerticalAlignment="Center" Visibility="{x:Bind ShowBoth(Model.ShowKeepRule, Model.HasResults), Mode=OneWay}"
                          ToolTipService.ToolTip="Qual cópia de cada grupo fica" />
                <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Model.RemoveCommand}" VerticalAlignment="Center"
                        Visibility="{x:Bind Show(Model.HasResults), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsRemoving, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Show(Model.IsRemoving), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Visibility="{x:Bind Hide(Model.IsRemoving), Mode=OneWay}" />
                        <TextBlock Text="Mover para a Lixeira" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
