<UserControl
    x:Class="Cleanup.App.Views.ExtensionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:controls="using:Cleanup.App.Controls"
    Loaded="OnLoaded">
    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedItems" Source="{x:Bind Model.ShownGroups, Mode=OneWay}" IsSourceGrouped="True" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18,24,12">
            <StackPanel Spacing="2">
                <TextBlock Text="Extensões" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind Model.LoadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Width="12" Height="12" Visibility="{x:Bind Model.IsLoading, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Visibility="{x:Bind Hide(Model.IsLoading), Mode=OneWay}" />
                    <TextBlock Text="Atualizar" />
                </StackPanel>
            </Button>
        </Grid>
        <controls:SelectionBar Grid.Row="1" List="{x:Bind Model}" Visibility="{x:Bind Model.HasSelectableRows, Mode=OneWay}" />

        <!-- Loading the first time -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ShowFirstLoad(Model.HasLoaded), Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Width="64" Height="64" HorizontalAlignment="Center" />
            <TextBlock Text="Procurando extensões…" Style="{StaticResource ModuleTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Extensões do Explorador e de navegadores, protetores de tela e suplementos do Office." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Nothing found -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="{x:Bind ShowNone(Model.HasLoaded, Model.RowCount), Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource OkBrush}" />
            <TextBlock Text="Nenhuma extensão" Style="{StaticResource ModuleTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Nenhuma extensão do Explorador, de navegador ou protetor de tela encontrado." Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}" SelectionMode="None" Padding="10,0,10,8"
                  Visibility="{x:Bind Model.HasRows, Mode=OneWay}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:RowGroup">
                            <StackPanel Padding="4,12,8,4" Spacing="2">
                                <Grid>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock Text="{x:Bind Trailing}" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="{x:Bind HasNote}" FontWeight="Normal" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExtensionRow">
                    <Border Style="{StaticResource RowCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Visibility="{x:Bind CanSelect}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{ThemeResource SurfaceSoftBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource AccentBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource TagStyle}" Background="{ThemeResource SurfaceSoftBrush}" Visibility="{x:Bind HasTag}">
                                <TextBlock Text="{x:Bind Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BodyBrush}" />
                            </Border>
                            <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="6" AutomationProperties.Name="Mais opções" VerticalAlignment="Center"
                                    Click="OnReveal" Tag="{x:Bind}" IsEnabled="{x:Bind CanReveal}" ToolTipService.ToolTip="Mostrar no Explorador">
                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="3" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12"
                Visibility="{x:Bind Model.HasLoaded, Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SELECIONADO" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{x:Bind Model.SelectedSizeText, Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="22" />
                </StackPanel>
                <controls:BannerView Grid.Column="1" VerticalAlignment="Center" Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Model.RemoveCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsRemoving, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Model.IsRemoving, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Visibility="{x:Bind Hide(Model.IsRemoving), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind RemoveLabel(Model.SelectedCount), Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
