<ContentDialog
    x:Class="Cleanup.App.Views.HistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:controls="using:Cleanup.App.Controls"
    Title="Histórico de limpezas"
    CloseButtonText="Fechar"
    DefaultButton="Close">
    <Grid RowSpacing="10" MinWidth="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Itens que foram para a Lixeira podem voltar para o lugar enquanto estiverem lá. Nada é sobrescrito."
                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="Nenhuma limpeza registrada ainda." Style="{StaticResource BodyTextStyle}"
                   Visibility="{x:Bind Empty(Model.Rows.Count), Mode=OneWay}" />
        <ListView Grid.Row="1" ItemsSource="{x:Bind Model.Rows}" SelectionMode="None" MaxHeight="420">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                    <Border Style="{StaticResource RowCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{x:Bind When}" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Content="Desfazer" IsEnabled="{x:Bind CanUndo}"
                                    Click="OnUndo" Tag="{x:Bind}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <controls:BannerView Grid.Row="2" Banner="{x:Bind Model.Banner, Mode=OneWay}" />
    </Grid>
</ContentDialog>
