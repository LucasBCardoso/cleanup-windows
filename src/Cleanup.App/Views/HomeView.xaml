<UserControl
    x:Class="Cleanup.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels">
    <ScrollViewer>
        <Grid Padding="28,22,28,28" RowSpacing="20" MaxWidth="1280">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="Greeting" Style="{StaticResource DisplayTextStyle}" />
                    <TextBlock Text="{x:Bind Subtitle(Scan.Phase, Scan.SafeSelectedSize), Mode=OneWay}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{ThemeResource MuteBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Bottom" Command="{x:Bind Scan.ScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Verificar de novo" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Hero: Espaço para liberar -->
                <Border Background="{ThemeResource HeroGradientBrush}" CornerRadius="{StaticResource HeroCornerRadius}" Padding="30" MinHeight="380"
                        BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Espaço para liberar" FontFamily="{StaticResource TextFontFamily}" FontSize="14" FontWeight="Medium"
                                   Foreground="{ThemeResource HeroForegroundBrush}" />

                        <!-- Not scanned yet -->
                        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind Show(Scan.IsIdle), Mode=OneWay}">
                            <TextBlock Text="?" Style="{StaticResource DisplayTextStyle}" FontSize="84" Foreground="{ThemeResource HeroAmountBrush}" Margin="0,14,0,0" />
                            <TextBlock Text="Caches, temporários, relatórios de erro e mais. Nada é removido sem você ver." TextWrapping="Wrap"
                                       FontFamily="{StaticResource TextFontFamily}" FontSize="14" Foreground="{ThemeResource HeroForegroundBrush}" />
                        </StackPanel>

                        <!-- Scanning -->
                        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind Show(Scan.IsScanning), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Percent(Scan.Progress), Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="72"
                                       Foreground="{ThemeResource HeroAmountBrush}" Margin="0,14,0,0" />
                            <TextBlock Text="{x:Bind Checking(Scan.CurrentTask), Mode=OneWay}" FontFamily="{StaticResource TextFontFamily}" FontSize="14"
                                       Foreground="{ThemeResource HeroForegroundBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Results -->
                        <StackPanel Grid.Row="1" Spacing="10" Visibility="{x:Bind Show(Scan.HasResults), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Bytes(Scan.SafeSelectedSize), Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="76"
                                       Foreground="{ThemeResource HeroAmountBrush}" Margin="0,14,0,10" />
                            <ItemsControl ItemsSource="{x:Bind TopGroups(Scan.SafeSelectedSize), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HeroGroup">
                                        <Grid Padding="0,0,0,8" Margin="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource HeroDividerBrush}">
                                            <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource TextFontFamily}" FontSize="14" FontWeight="Medium"
                                                       Foreground="{ThemeResource HeroForegroundBrush}" />
                                            <TextBlock Text="{x:Bind Size}" FontFamily="{StaticResource TextFontFamily}" FontSize="14" FontWeight="Medium"
                                                       Foreground="{ThemeResource HeroForegroundBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind SkippedText(Scan.Skipped), Mode=OneWay}" FontFamily="{StaticResource TextFontFamily}" FontSize="12.5"
                                       Foreground="{ThemeResource HeroForegroundBrush}" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                            <Button Style="{StaticResource HeroButtonStyle}" Command="{x:Bind Scan.ScanCommand}" Visibility="{x:Bind Show(Scan.IsIdle), Mode=OneWay}"
                                    Content="Verificar agora" />
                            <Button Style="{StaticResource HeroButtonStyle}" Command="{x:Bind Scan.CleanSafeCommand}" Visibility="{x:Bind Show(Scan.HasResults), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="{x:Bind Scan.IsCleaning, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource HeroButtonTextBrush}"
                                                  Visibility="{x:Bind Show(Scan.IsCleaning), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind CleanLabel(Scan.IsCleaning), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource HeroForegroundBrush}" BorderBrush="{ThemeResource HeroDividerBrush}"
                                    Padding="20,10" CornerRadius="19" Click="OnDetails" Visibility="{x:Bind Show(Scan.HasResults), Mode=OneWay}" Content="Ver detalhes" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tiles -->
                <StackPanel Grid.Column="1" Spacing="18">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource AccentInkBrush}" />
                                    <TextBlock Text="Disco" Style="{StaticResource RowTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="DiskFree" Style="{StaticResource DisplayTextStyle}" FontSize="30" />
                                <TextBlock x:Name="DiskLine" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <ProgressBar x:Name="DiskBar" Maximum="1" Height="6" CornerRadius="3" Margin="0,6,0,0" />
                                <HyperlinkButton Content="Abrir Space Lens" Padding="0" Margin="0,4,0,0" Click="OnSpaceLens" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource AccentInkBrush}" />
                                    <TextBlock Text="Lixeira" Style="{StaticResource RowTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="BinSize" Style="{StaticResource DisplayTextStyle}" FontSize="30" />
                                <TextBlock x:Name="BinLine" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="Abrir a Lixeira" Padding="0" Margin="0,4,0,0" Click="OnOpenBin" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AccentInkBrush}" />
                                    <TextBlock Text="Arquivos grandes" Style="{StaticResource RowTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Vídeos, imagens de disco e instaladores esquecidos na sua pasta pessoal." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="Procurar" Padding="0" Margin="0,4,0,0" Click="OnLargeFiles" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC4A;" FontSize="14" Foreground="{ThemeResource AccentInkBrush}" />
                                    <TextBlock Text="Otimização total" Style="{StaticResource RowTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Lixo seguro, memória, DNS e inicialização quebrada, de uma vez." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="Abrir Otimização" Padding="0" Margin="0,4,0,0" Click="OnOptimization" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Última limpeza: undo -->
                    <Border Background="{ThemeResource HeroGradientBrush}" CornerRadius="20" Padding="20" Visibility="{x:Bind ShowUndo(History.LastUndoable), Mode=OneWay}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Última limpeza" FontFamily="{StaticResource TextFontFamily}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource HeroForegroundBrush}" Opacity="0.85" />
                                <TextBlock Text="{x:Bind UndoTitle(History.LastUndoable), Mode=OneWay}" FontFamily="{StaticResource TextFontFamily}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{ThemeResource HeroForegroundBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind UndoStatus(History.LastUndoable), Mode=OneWay}" FontFamily="{StaticResource TextFontFamily}" FontSize="12.5"
                                           Foreground="{ThemeResource HeroForegroundBrush}" TextWrapping="Wrap" Opacity="0.85" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource HeroButtonStyle}" Click="OnUndo" IsEnabled="{x:Bind Not(History.IsRestoring), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing IsActive="{x:Bind History.IsRestoring, Mode=OneWay}" Width="16" Height="16"
                                                      Foreground="{ThemeResource HeroButtonTextBrush}" Visibility="{x:Bind Show(History.IsRestoring), Mode=OneWay}" />
                                        <TextBlock Text="Desfazer" />
                                    </StackPanel>
                                </Button>
                                <HyperlinkButton Content="Histórico" HorizontalAlignment="Center" Foreground="{ThemeResource HeroForegroundBrush}" Click="OnHistory" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind BannerText(History.Banner), Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
