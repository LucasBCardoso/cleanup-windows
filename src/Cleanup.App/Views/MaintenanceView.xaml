<UserControl
    x:Class="Cleanup.App.Views.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:controls="using:Cleanup.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Padding="24,18,24,12" Spacing="2">
            <TextBlock Text="Manutenção" Style="{StaticResource ModuleTitleStyle}" />
            <TextBlock Text="{x:Bind Model.Subtitle}" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <!-- "Selecionar tudo" (leaves out the slow tasks) and "N de M selecionados". -->
        <Grid Grid.Row="1" Padding="22,0,22,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAll" IsThreeState="True" Click="OnSelectAllClick" MinWidth="0" VerticalAlignment="Center"
                      IsChecked="{x:Bind Model.SelectAllState, Mode=OneWay}" IsEnabled="{x:Bind Not(Model.IsRunning), Mode=OneWay}">
                <TextBlock Text="{x:Bind Model.SelectAllText, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
            </CheckBox>
            <TextBlock Grid.Column="1" Text="As tarefas demoradas precisam ser marcadas uma a uma." Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind Model.CountLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" Padding="22,0,22,10">
            <ItemsControl ItemsSource="{x:Bind Model.Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MaintenanceTaskRow">
                        <Border Style="{StaticResource RowCardStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind ControlsEnabled, Mode=OneWay}" MinWidth="0" Padding="0"
                                          VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{x:Bind Name}" />
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="10" Background="{ThemeResource SurfaceSoftBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentInkBrush}" />
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" Foreground="{ThemeResource BodyBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind IsAdmin}">
                                            <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource MuteBrush}" />
                                            <TextBlock Text="Pede permissão de administrador" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind IsSlow}">
                                            <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource MuteBrush}" />
                                            <TextBlock Text="Demorada" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ShowOk, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource OkBrush}" />
                                            <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" Foreground="{ThemeResource OkBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ShowFailed, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind ResultDetail, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE783;" FontSize="11" Foreground="{ThemeResource DangerBrush}" />
                                            <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" Foreground="{ThemeResource DangerBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind IsRunning, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                    <Button Style="{StaticResource SubtleButtonStyle}" Click="OnRun" Tag="{x:Bind}" IsEnabled="{x:Bind ControlsEnabled, Mode=OneWay}"
                                            Visibility="{x:Bind ShowRunButton, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                            <TextBlock Text="Executar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <controls:BannerView Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind Model.SelectedNeedsAdmin, Mode=OneWay}">
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource MuteBrush}" />
                        <TextBlock Text="Pede permissão de administrador uma vez para todas" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnRunSelected" IsEnabled="{x:Bind Model.CanRunSelected, Mode=OneWay}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsRunningSelection, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Model.IsRunningSelection, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE768;" FontSize="12" Visibility="{x:Bind Hide(Model.IsRunningSelection), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Model.RunSelectedText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
