<UserControl
    x:Class="Cleanup.App.Views.OptimizationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:controls="using:Cleanup.App.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedItems" Source="{x:Bind Model.Groups, Mode=OneWay}" IsSourceGrouped="True" />

        <DataTemplate x:Key="ProcessTemplate" x:DataType="vm:ProcessRow">
            <Border Style="{StaticResource RowCardStyle}" Padding="12,8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource AccentInkBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="{x:Bind PidText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText, Mode=OneWay}" Style="{StaticResource NumberTextStyle}" Foreground="{ThemeResource InkBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="6" AutomationProperties.Name="Mais opções" VerticalAlignment="Center" ToolTipService.ToolTip="Encerrar">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource BodyBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Opening="OnProcessMenuOpening" Closed="OnProcessMenuClosed">
                                <MenuFlyoutItem Text="Encerrar" Click="OnQuit" IsEnabled="{x:Bind CanQuit, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Forçar encerramento…" Click="OnForceQuit" IsEnabled="{x:Bind CanQuit, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, the two tabs, search + refresh on the startup tab. -->
        <Grid Padding="24,18,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Otimização" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="StartupTab" Style="{StaticResource SubTabButtonStyle}" Click="OnStartupTab" IsChecked="{x:Bind Model.IsStartupTab, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE7E8;" FontSize="13" />
                        <TextBlock Text="Itens de inicialização" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ConsumersTab" Style="{StaticResource SubTabButtonStyle}" Click="OnConsumersTab" IsChecked="{x:Bind Model.IsConsumersTab, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                        <TextBlock Text="Consumo" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <TextBox Grid.Column="2" Style="{StaticResource SearchBoxStyle}" PlaceholderText="Buscar item" VerticalAlignment="Center"
                     Text="{x:Bind Model.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind Model.IsStartupTab, Mode=OneWay}" />
            <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Click="OnRefresh" VerticalAlignment="Center"
                    IsEnabled="{x:Bind Not(Model.IsLoading), Mode=OneWay}" Visibility="{x:Bind Model.IsStartupTab, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Width="12" Height="12" Visibility="{x:Bind Model.IsLoading, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Visibility="{x:Bind Hide(Model.IsLoading), Mode=OneWay}" />
                    <TextBlock Text="Atualizar" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Itens de inicialização -->
        <Grid Grid.Row="1" Visibility="{x:Bind Model.IsStartupTab, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind Model.ShowLoading, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind Model.ShowLoading, Mode=OneWay}" Width="56" Height="56" />
                <TextBlock Text="Lendo itens de inicialização…" Style="{StaticResource ModuleTitleStyle}" FontSize="20" HorizontalAlignment="Center" />
                <TextBlock Text="Registro, pasta Inicializar, tarefas agendadas e serviços." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}" SelectionMode="None" Padding="10,0,10,8"
                      Visibility="{x:Bind Hide(Model.ShowLoading), Mode=OneWay}">
                <ListView.Header>
                    <Border Style="{StaticResource RowCardStyle}" Margin="4,0,4,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="{ThemeResource AccentInkBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Apps de inicialização do Windows" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Os mesmos itens aparecem em Configurações › Apps › Inicialização e no Gerenciador de Tarefas."
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Click="OnOpenStartupSettings" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                    <TextBlock Text="Abrir Configurações" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </ListView.Header>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="ListViewHeaderItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:StartupRowGroup">
                                <Grid Padding="4,10,8,4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock Text="{x:Bind Trailing}" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupRow">
                        <Border Style="{StaticResource RowCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentInkBrush}" />
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource DangerBrush}" Visibility="{x:Bind IsBroken}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" ToolTipService.ToolTip="{x:Bind Subtitle}" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" FontSize="11.5" Opacity="0.85" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind IsBroken}">
                                        <TextBlock Text="Quebrado" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WarnBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="{ThemeResource SurfaceSoftBrush}" Visibility="{x:Bind IsDisabled}">
                                        <TextBlock Text="Desativado" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuteBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Background="{ThemeResource SurfaceSoftBrush}" Visibility="{x:Bind IsOnce}">
                                        <TextBlock Text="Só uma vez" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BodyBrush}" />
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ShowActions, Mode=OneWay}">
                                        <Button Style="{StaticResource SubtleButtonStyle}" Content="{x:Bind ToggleText}" Click="OnToggle" Tag="{x:Bind}"
                                                Visibility="{x:Bind ShowToggle}" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}" Click="OnRemove" Tag="{x:Bind}" IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                <TextBlock Text="Remover" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button Style="{StaticResource SubtleButtonStyle}" Click="OnRestore" Tag="{x:Bind}" Visibility="{x:Bind ShowRestore, Mode=OneWay}"
                                            IsEnabled="{x:Bind ActionsEnabled, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                            <TextBlock Text="Restaurar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Padding="6" Click="OnReveal" Tag="{x:Bind}" Visibility="{x:Bind ShowReveal}"
                                            ToolTipService.ToolTip="Mostrar no Explorador">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="{ThemeResource BodyBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Consumo: the heaviest processes of the user, live. -->
        <Grid Grid.Row="1" Padding="22,0,22,8" ColumnSpacing="14" Visibility="{x:Bind Model.IsConsumersTab, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}" Margin="4,4,0,6" />
                <ProgressRing Grid.Row="1" IsActive="{x:Bind IsEmpty(Model.TopCpu.Count), Mode=OneWay}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,20,0,0" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind Model.TopCpu}" SelectionMode="None" ItemTemplate="{StaticResource ProcessTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="MEMÓRIA" Style="{StaticResource SectionLabelStyle}" Margin="4,4,0,6" />
                <ProgressRing Grid.Row="1" IsActive="{x:Bind IsEmpty(Model.TopMemory.Count), Mode=OneWay}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,20,0,0" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind Model.TopMemory}" SelectionMode="None" ItemTemplate="{StaticResource ProcessTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>

        <!-- Footer: Otimização total (the same as on Hoje) and the result of the last action. -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <controls:BannerView Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                    <controls:BannerView Banner="{x:Bind Optimizer.Banner, Mode=OneWay}" Dismissed="OnOptimizerBannerDismissed" />
                    <TextBlock Text="{x:Bind FooterText(Optimizer.Step), Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Optimizer.OptimizeAllCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Optimizer.IsRunning, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Optimizer.IsRunning, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE945;" FontSize="13" Visibility="{x:Bind Hide(Optimizer.IsRunning), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Optimizer.ButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
