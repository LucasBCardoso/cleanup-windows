<UserControl
    x:Class="Cleanup.App.Views.PrivacyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:controls="using:Cleanup.App.Controls"
    Loaded="OnLoaded">
    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedItems" Source="{x:Bind Model.Groups, Mode=OneWay}" IsSourceGrouped="True" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Privacidade" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="Histórico, cookies, itens recentes e redes Wi-Fi" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" Command="{x:Bind Model.LoadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Width="12" Height="12" Foreground="{ThemeResource InkBrush}"
                                  Visibility="{x:Bind Show(Model.IsLoading), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Visibility="{x:Bind Hide(Model.IsLoading), Mode=OneWay}" />
                    <TextBlock Text="Atualizar" />
                </StackPanel>
            </Button>
        </Grid>
        <controls:SelectionBar Grid.Row="1" List="{x:Bind Model}" IsEnabled="{x:Bind Model.IsIdle, Mode=OneWay}"
                               Visibility="{x:Bind ShowAny(Model.TotalCount), Mode=OneWay}" />

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind Show(Model.ShowLoading), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="56" Height="56" />
            <TextBlock Text="Procurando rastros…" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420"
                    Visibility="{x:Bind Show(Model.ShowEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource OkBrush}" />
            <TextBlock Text="Nada para apagar" Style="{StaticResource ModuleTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Nenhum histórico, cookie ou item recente encontrado." Style="{StaticResource BodyTextStyle}" TextAlignment="Center" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}" SelectionMode="None" Padding="10,0,10,8"
                  IsEnabled="{x:Bind Model.IsIdle, Mode=OneWay}" Visibility="{x:Bind ShowAny(Model.TotalCount), Mode=OneWay}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ItemGroup">
                            <Grid Padding="4,10,8,4">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PrivacyRow">
                    <Border Style="{StaticResource RowCardStyle}" Opacity="{x:Bind RowOpacity}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind IsBlocked}">
                                    <TextBlock Text="{x:Bind BlockedReason}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WarnBrush}" />
                                </Border>
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource MuteBrush}" Visibility="{x:Bind IsWiFi}"
                                          ToolTipService.ToolTip="Pede permissão de administrador" />
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{x:Bind Trailing}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <TextBlock Text="{x:Bind Model.WiFiNote, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                           Margin="12,6,12,4" Visibility="{x:Bind ShowText(Model.WiFiNote), Mode=OneWay}" />
            </ListView.Footer>
        </ListView>

        <Border Grid.Row="3" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SELECIONADO" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{x:Bind Model.SelectedSizeText, Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="22" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <controls:BannerView Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource MuteBrush}" />
                        <TextBlock Text="Apagado definitivamente: não vai para a Lixeira" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnClean" IsEnabled="{x:Bind Model.CanClean, Mode=OneWay}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsCleaning, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Show(Model.IsCleaning), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind Hide(Model.IsCleaning), Mode=OneWay}" />
                        <TextBlock Text="Apagar selecionados" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
