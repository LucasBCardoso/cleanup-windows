<UserControl
    x:Class="Cleanup.App.Views.SpaceLensView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:controls="using:Cleanup.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18,24,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Space Lens" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="O que ocupa espaço, pasta por pasta. Clique duas vezes para entrar numa pasta." Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox ItemsSource="{x:Bind Model.Drives}" SelectedItem="{x:Bind Model.SelectedDrive, Mode=TwoWay}" MinWidth="160"
                          VerticalAlignment="Center" />
                <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.RefreshCommand}" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Medir de novo esta pasta e o disco (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Atualizar" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Disk strip: used / free -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="24,0,24,12" Padding="18,14">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="{x:Bind DriveTitle(Model.SelectedDrive), Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="{x:Bind DriveSummary(Model.SelectedDrive), Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Maximum="1" Value="{x:Bind DriveUsed(Model.SelectedDrive), Mode=OneWay}" Height="10" CornerRadius="5" />
            </StackPanel>
        </Border>

        <!-- Breadcrumbs -->
        <Grid Grid.Row="2" Padding="24,0,24,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.UpCommand}" ToolTipService.ToolTip="Pasta acima">
                <FontIcon Glyph="&#xE74A;" FontSize="12" />
            </Button>
            <BreadcrumbBar Grid.Column="1" x:Name="Crumbs" ItemsSource="{x:Bind CrumbNames, Mode=OneWay}" ItemClicked="OnCrumb" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind Model.IsMeasuring, Mode=OneWay}" Width="16" Height="16" />
                <TextBlock Text="{x:Bind Status(Model.IsMeasuring, Model.MeasuredCount, Model.ChildCount, Model.TotalText), Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="3" x:Name="List" ItemsSource="{x:Bind Model.Rows}" SelectionMode="Single" Padding="10,0,10,8"
                  DoubleTapped="OnDoubleTapped" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LensRow">
                    <Grid ColumnSpacing="12" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource AccentInkBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Maximum="1" Value="{x:Bind Fraction}" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource NumberTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Abrir" Click="OnOpen" Tag="{x:Bind}" IsEnabled="{x:Bind CanOpen}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Mostrar no Explorador" Click="OnReveal" Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Mover para a Lixeira…" Click="OnRecycle" Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="4" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,10"
                Visibility="{x:Bind HasBanner(Model.Banner), Mode=OneWay}">
            <controls:BannerView Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
        </Border>
    </Grid>
</UserControl>
