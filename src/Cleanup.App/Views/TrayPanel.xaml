<Window
    x:Class="Cleanup.App.Views.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    Title="Cleanup">
    <!-- The tray panel (macOS menu bar panel): CPU, memory and pressure, disk, battery, alerts with snooze. -->
    <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" Padding="18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#x2726;" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Cleanup" Style="{StaticResource RowTitleStyle}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{x:Bind Health.Summary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Maximum="1" Value="{x:Bind Health.CpuFraction, Mode=OneWay}" Height="6" CornerRadius="3" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Health.CpuText, Mode=OneWay}" Style="{StaticResource NumberTextStyle}" MinWidth="40" TextAlignment="Right" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Memória" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Maximum="1" Value="{x:Bind Health.MemoryFraction, Mode=OneWay}" Height="6" CornerRadius="3" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Health.PressureText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </Grid>
            <TextBlock Text="{x:Bind Health.MemoryText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Margin="90,-6,0,0" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Disco" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Maximum="1" Value="{x:Bind Health.DiskFraction, Mode=OneWay}" Height="6" CornerRadius="3" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Bind Health.DiskText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Margin="90,-6,0,0" />
            <Grid ColumnSpacing="10" Visibility="{x:Bind Show(Health.HasBattery), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bateria" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Health.BatteryText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </Grid>
            <TextBlock Text="{x:Bind Health.TopProcessText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock Text="{x:Bind Health.UptimeText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind Health.Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IssueRow">
                        <Border Style="{StaticResource RowCardStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="10" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                                    <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource DangerBrush}" Visibility="{x:Bind IsCritical}" />
                                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarnBrush}" Visibility="{x:Bind IsWarning}" />
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource MuteBrush}" Visibility="{x:Bind IsInfo}" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Message}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,4" FontSize="12" Content="{x:Bind ActionText}"
                                            Visibility="{x:Bind HasAction}" Click="OnIssueAction" Tag="{x:Bind}" />
                                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,4" FontSize="12" Content="Adiar">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="1 dia" Click="OnSnoozeDay" Tag="{x:Bind}" />
                                                <MenuFlyoutItem Text="1 semana" Click="OnSnoozeWeek" Tag="{x:Bind}" />
                                                <MenuFlyoutItem Text="Sempre" Click="OnSnoozeForever" Tag="{x:Bind}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Content="Abrir Cleanup" Click="OnOpen" />
            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Click="OnScan" ToolTipService.ToolTip="Verificar agora">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
        </Grid>
    </Grid>
</Window>
