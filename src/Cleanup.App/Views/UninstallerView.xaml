<UserControl
    x:Class="Cleanup.App.Views.UninstallerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cleanup.App.ViewModels"
    xmlns:views="using:Cleanup.App.Views"
    xmlns:controls="using:Cleanup.App.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Name="LeftoverItems" Source="{x:Bind Model.Leftovers.Groups, Mode=OneWay}" IsSourceGrouped="True" />
        <CollectionViewSource x:Name="ResetItems" Source="{x:Bind Model.ResetPlan.Groups, Mode=OneWay}" IsSourceGrouped="True" />

        <Style x:Key="PlanHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PlanItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <DataTemplate x:Key="PlanHeaderTemplate" x:DataType="vm:ItemGroup">
            <Grid Padding="4,10,8,4">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlanRowTemplate" x:DataType="vm:ItemRow">
            <Border Style="{StaticResource RowCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="6" AutomationProperties.Name="Mais opções" VerticalAlignment="Center"
                            Click="OnRevealItem" Tag="{x:Bind}" ToolTipService.ToolTip="Mostrar no Explorador"
                            Visibility="{x:Bind views:UninstallerView.RevealVisibility(Item.RuleId)}">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="24,18,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Desinstalador" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock Text="{x:Bind Model.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Model.FilterLabels}" SelectedIndex="{x:Bind Model.FilterIndex, Mode=TwoWay}"
                      MinWidth="200" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.RefreshCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" Width="12" Height="12"
                                  Visibility="{x:Bind Show(Model.IsLoading), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Visibility="{x:Bind Hide(Model.IsLoading), Mode=OneWay}" />
                    <TextBlock Text="Atualizar lista" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Apps -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource SearchBoxStyle}" PlaceholderText="Buscar app" Margin="8,0"
                         Text="{x:Bind Model.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind Show(Model.ShowAppsLoading), Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="40" Height="40" />
                    <TextBlock Text="Lendo seus aplicativos…" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{x:Bind Model.NoAppsText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource MuteBrush}"
                           Margin="12,8" Visibility="{x:Bind Show(Model.ShowNoApps), Mode=OneWay}" />
                <ListView Grid.Row="1" x:Name="AppList" ItemsSource="{x:Bind Model.VisibleApps}" SelectionMode="Single" SelectionChanged="OnAppSelected"
                          Padding="0,0,0,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppRow">
                            <Grid ColumnSpacing="12" Padding="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{ThemeResource SurfaceSoftBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentInkBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind IsSystem}" Padding="5,0">
                                            <TextBlock Text="sistema" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource WarnBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind IsStore}" Padding="5,0" Background="{ThemeResource SurfaceSoftBrush}">
                                            <TextBlock Text="Store" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource BodyBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind UsageText}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Nothing chosen -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind Show(Model.NoChosen), Mode=OneWay}">
                <FontIcon Glyph="&#xE76B;" FontSize="28" Foreground="{ThemeResource MuteBrush}" />
                <TextBlock Text="Selecione um app para ver o que será removido." Style="{StaticResource BodyTextStyle}" />
            </StackPanel>

            <!-- Chosen app -->
            <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind Show(Model.HasChosen), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource SurfaceSoftBrush}">
                            <FontIcon Glyph="{x:Bind Model.ChosenGlyph, Mode=OneWay}" FontSize="19" Foreground="{ThemeResource AccentInkBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Model.ChosenName, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" FontSize="16" />
                            <TextBlock Text="{x:Bind Model.ChosenDetails, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ToggleButton x:Name="UninstallTab" AutomationProperties.Name="Desinstalar" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind IsUninstallTab(Model.IsResetMode), Mode=OneWay}"
                                          Checked="OnUninstallTab" Unchecked="OnTabUnchecked" IsEnabled="{x:Bind Not(Model.IsBusy), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="Desinstalar" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ResetTab" AutomationProperties.Name="Redefinir" Style="{StaticResource SubTabButtonStyle}" IsChecked="{x:Bind Model.IsResetMode, Mode=OneWay}"
                                          Checked="OnResetTab" Unchecked="OnTabUnchecked" IsEnabled="{x:Bind Not(Model.IsBusy), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                    <TextBlock Text="Redefinir" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{x:Bind Show(Model.ShowChoosing), Mode=OneWay}" />

                <!-- Desinstalar -->
                <Grid Grid.Row="2" Visibility="{x:Bind Show(Model.ShowUninstallPane), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Model.UninstallNote, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontSize="13" Margin="6,0,6,8" />
                    <controls:SelectionBar Grid.Row="1" List="{x:Bind Model.Leftovers}"
                                           Visibility="{x:Bind Show(Model.ShowLeftovers), Mode=OneWay}" />
                    <ScrollViewer Grid.Row="2">
                        <StackPanel Spacing="4" Padding="0,0,0,8">
                            <TextBlock Text="Nenhuma sobra encontrada nas pastas do seu usuário." Style="{StaticResource CaptionTextStyle}" Margin="6,4"
                                       Visibility="{x:Bind Show(Model.ShowNoLeftovers), Mode=OneWay}" />
                            <ListView ItemsSource="{x:Bind LeftoverItems.View, Mode=OneWay}" SelectionMode="None" Padding="0"
                                      ScrollViewer.VerticalScrollMode="Disabled" ItemContainerStyle="{StaticResource PlanItemContainerStyle}"
                                      ItemTemplate="{StaticResource PlanRowTemplate}" Visibility="{x:Bind Show(Model.ShowLeftovers), Mode=OneWay}">
                                <ListView.GroupStyle>
                                    <GroupStyle HeaderContainerStyle="{StaticResource PlanHeaderContainerStyle}" HeaderTemplate="{StaticResource PlanHeaderTemplate}" />
                                </ListView.GroupStyle>
                            </ListView>
                            <StackPanel Spacing="4" Margin="4,8,4,0" Visibility="{x:Bind Show(Model.ShowReportOnly), Mode=OneWay}">
                                <TextBlock Text="EM PASTAS DO SISTEMA" Style="{StaticResource SectionLabelStyle}" Margin="4,0" />
                                <TextBlock Text="Pedem administrador: o desinstalador do app costuma removê-las. O Cleanup só mostra, para você conferir."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="4,0,4,4" />
                                <ItemsControl ItemsSource="{x:Bind Model.ReportOnly}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReportRow">
                                            <Border Style="{StaticResource RowCardStyle}" Margin="0,2" Opacity="0.85">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource MuteBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                                        <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Style="{StaticResource NumberTextStyle}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="6" AutomationProperties.Name="Mais opções" VerticalAlignment="Center"
                                                            Click="OnRevealReport" Tag="{x:Bind}" ToolTipService.ToolTip="Mostrar no Explorador">
                                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Redefinir -->
                <Grid Grid.Row="2" Visibility="{x:Bind Show(Model.ShowResetPane), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Model.ResetNote, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontSize="13" Margin="6,0,6,8" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="6,0,6,8" Visibility="{x:Bind Show(Model.ShowRunningWarning), Mode=OneWay}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource WarnBrush}" />
                        <TextBlock Text="{x:Bind Model.RunningWarning, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontSize="13" Foreground="{ThemeResource WarnBrush}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton Content="Verificar de novo" Click="OnCheckRunning" Padding="4,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:SelectionBar Grid.Row="2" List="{x:Bind Model.ResetPlan}"
                                           Visibility="{x:Bind Show(Model.ShowResetList), Mode=OneWay}" />
                    <ListView Grid.Row="3" ItemsSource="{x:Bind ResetItems.View, Mode=OneWay}" SelectionMode="None" Padding="0,0,0,8"
                              ItemContainerStyle="{StaticResource PlanItemContainerStyle}" ItemTemplate="{StaticResource PlanRowTemplate}"
                              Visibility="{x:Bind Show(Model.ShowResetList), Mode=OneWay}">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderContainerStyle="{StaticResource PlanHeaderContainerStyle}" HeaderTemplate="{StaticResource PlanHeaderTemplate}" />
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource SurfaceBrush}" Padding="24,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MinWidth="120">
                    <TextBlock Text="SELECIONADO" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{x:Bind Model.FooterSizeText, Mode=OneWay}" Style="{StaticResource DisplayTextStyle}" FontSize="22" />
                </StackPanel>
                <controls:BannerView Grid.Column="1" VerticalAlignment="Center" Banner="{x:Bind Model.Banner, Mode=OneWay}" Dismissed="OnBannerDismissed" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnAct" IsEnabled="{x:Bind Model.CanAct, Mode=OneWay}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Model.IsWorking, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource OnAccentBrush}"
                                      Visibility="{x:Bind Show(Model.IsWorking), Mode=OneWay}" />
                        <FontIcon Glyph="{x:Bind Model.ActionGlyph, Mode=OneWay}" FontSize="14" Visibility="{x:Bind Show(Model.ShowActionGlyph), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Model.ActionText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
